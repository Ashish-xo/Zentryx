# Zentryx uses BYOK (Bring Your Own Key) — visitors supply their OWN API key
# in the site's Settings → AI Connection panel. The key is stored in the
# visitor's browser and forwarded to their chosen provider on each request.
# The site owner does NOT need an API key anymore.
#
# Optional: if you want to run the local dev server with a test key,
# create a .env with OPENCODE_API_KEY=<your-test-key>. It is ONLY used by
# the dev server for direct testing — the deployed site never uses it.
OPENCODE_API_KEY=sk-you...here
