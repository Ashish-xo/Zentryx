# Copy this file to .env and fill in your real key.
# The dev server reads .env automatically (dev-server.js).
# NEVER commit .env — it is gitignored.
#
# Get a key from https://opencode.ai (account → API keys).
# IMPORTANT: if this key ever appeared in git history or in the
# browser-facing code, generate a NEW key and revoke the old one.
OPENCODE_API_KEY=sk-your-real-key-here
